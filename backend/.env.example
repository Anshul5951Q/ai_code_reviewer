# AI Code Reviewer - Backend Environment Configuration Example
# Copy this file to .env and fill in your values
# DO NOT put sensitive credentials or production secrets in this file.

# Application
APP_ENV=development
APP_NAME="AI Code Reviewer"
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_code_reviewer.db

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API
API_PREFIX=/api

# GitHub OAuth & Secure Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here
FRONTEND_URL=http://localhost:3000

# Redis (Background Worker Queue)
REDIS_URL=redis://localhost:6379/0

# Ollama Local LLM Runtime (Phase 7 - Local Only, No Cloud LLMs)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENT=1
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=15m
OLLAMA_MAX_RETRIES=2
