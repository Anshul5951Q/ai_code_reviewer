# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
APP_NAME="AI Code Reviewer"
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:Anshul%402005@localhost:5432/ai_code_reviewer

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API
API_PREFIX=/api

# GitHub Integration
# Option A: GitHub OAuth App (Register at https://github.com/settings/developers)
# - Homepage URL: http://localhost:3000
# - Callback URL: http://localhost:8000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN_ENCRYPTION_KEY=fz55YUIeLX68MJtGIo0_45OjMwkdNSxn-KNpY8Pk1bw=
FRONTEND_URL=http://localhost:3000

# Option B: Server-level GitHub Personal Access Token (PAT) fallback
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# Redis / RQ (Phase 3 background worker)
REDIS_URL=redis://localhost:6379/0

# AI Agents (Future phase)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
